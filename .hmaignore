# OASB is a security benchmark. The paths below are malicious-by-design test
# data and detection tooling, not application code. Scanning them produces
# expected findings (attack payloads, fake placeholder credentials, secret-
# detection regexes) that are the benchmark's purpose, not vulnerabilities.

# Benchmark corpus: labeled malicious + benign attack samples.
corpus/

# Secret-detection ruleset (contains regexes that match credential shapes).
.gitleaks.toml

# DVAA harness: connects to the intentionally-vulnerable DVAA agent endpoints.
src/harness/dvaa-manager.ts
src/harness/dvaa-client.ts
scripts/run-dvaa-benchmark.ts

# False positives of `hackmyagent secure` 0.33.2. Each rule below leaves out
# one check on one file; every other check still runs on that file.
package.json:AIM-001 # OASB is a benchmark library, not an agent, so it has no agent identity to declare
scripts/check-documented-commands.test.mjs:NEMO-009 # new Function() compiles what placeholdersToChecks returns for a code string written in the test itself
results/2026-10-10-2a89ce5d/record.json:AST-CRED-003 # the flagged value is oasb.commit, the git commit the pinned run measured
results/2026-10-10-d8306ef8/record.json:AST-CRED-003 # the flagged value is oasb.commit, the git commit the pinned run measured
src/benchmark/pinned/inputs.ts:NEMO-002 # the flagged line throws PinError when a tarball's hash differs from the integrity package-lock.json names, and an entry with no integrity throws PinError before it, so no digest check is skipped
